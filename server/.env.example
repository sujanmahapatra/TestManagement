# Copy to .env and fill in. NEVER commit .env.
# In production, inject these from a secret manager instead of a file.

# ---- HTTP ----
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# The project name shown in the left menu and top bar until it is renamed in the app.
PROJECT_NAME=Default project

# ---- Sign-in ----
# A shared password in front of the whole app (at least 8 characters).
# People sign in once per browser and stay signed in for 30 days; changing
# it signs everyone out. Leave empty to keep the app open.
APP_PASSWORD=

# ---- Destinations ----
# Which export targets are enabled. Only the blocks for the destinations
# listed here are validated at boot, so a Jira-only deployment needs none of
# the Azure DevOps or TFS settings below.
DESTINATIONS=jira,confluence,excel,ado,tfs

# ---- Generation ----
# template = deterministic expansion from config/generation.json (default)
# llm      = Claude writes the steps; structure stays deterministic
GENERATOR=template
# Required when GENERATOR=llm. Setting it also turns on the AI test case
# agent (the "ai agent" tab), whichever GENERATOR is chosen.
ANTHROPIC_API_KEY=
GENERATOR_MODEL=claude-opus-5-5
# Optional: an Anthropic-compatible endpoint instead of Anthropic's API. For
# DeepSeek, set this, put the DeepSeek key in ANTHROPIC_API_KEY, and set
# GENERATOR_MODEL=deepseek-v4-pro. PDFs and Office files are then sent as text.
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# Optional, free tier: Groq (https://console.groq.com -> API Keys). When set,
# the agent uses Groq instead of the Anthropic settings above. Text only:
# screenshots and Figma frames need a vision model.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Output budget per agent run (default 64000 for Claude, 6000 for Groq's free
# tier, 32000 otherwise).
# AGENT_MAX_TOKENS=
# How hard the agent thinks: low | medium | high (default) | xhigh | max.
# Higher finds more cases on long PRDs and costs more per run.
AGENT_EFFORT=high
# Optional: lets the agent import Figma designs as context. A personal access
# token with "File content: read" (Figma -> Settings -> Security).
FIGMA_TOKEN=
# Point this at your own file to override platforms, test types and the
# negative-variant catalogue without changing code.
GENERATION_CONFIG_PATH=

# ---- Atlassian API token -- the simplest way to link Jira and Confluence ----
# Create one at https://id.atlassian.com/manage-profile/security/api-tokens.
# When set, the OAuth settings below are not needed, nobody has to "connect"
# in the browser, and everything is filed as this one account.
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
# Link type used to tie a filed test case to its story (default Relates).
JIRA_LINK_TYPE=

# ---- Atlassian OAuth 2.0 (3LO) -- the alternative, per-user sign-in ----
# https://developer.atlassian.com/console/myapps/ -> your app -> Settings
CLIENT_ID=
CLIENT_SECRET=
# Must match the callback registered in the developer console byte for byte.
REDIRECT_URI=http://localhost:4000/auth/callback

# ---- Jira ----
# Used to build user-facing links; REST calls address the site by cloudId.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_PROJECT_KEY=QA
JIRA_ISSUE_TYPE=Test
# Optional: custom field holding the platform, e.g. customfield_10050.
JIRA_PLATFORM_FIELD=
JIRA_DEFAULT_LABELS=generated,automation-candidate
# Optional: any other fields the project's create screen requires, as JSON.
# Merged last, but cannot overwrite project/issuetype/summary/description.
JIRA_EXTRA_FIELDS={"priority":{"name":"Medium"}}

# ---- Confluence ----
# Defaults to JIRA_BASE_URL when blank (same Atlassian site).
CONFLUENCE_BASE_URL=
CONFLUENCE_SPACE_KEY=QADOCS
# Optional: file generated pages under this page id.
CONFLUENCE_PARENT_PAGE_ID=

# ---- Excel ----
# No credentials: the workbook is returned to the browser as a download.
EXCEL_SHEET_NAME=Test Case

# ---- Azure DevOps ----
# ADO_ORG_URL + ADO_PAT alone let the generator import work items as
# requirements (PAT scope: Work Items - Read). Filing test cases there also
# needs ADO_PROJECT, "ado" in DESTINATIONS, and the Read & write scope.
ADO_ORG_URL=https://dev.azure.com/your-org
ADO_PROJECT=
ADO_PAT=
ADO_WORK_ITEM_TYPE=Test Case
ADO_API_VERSION=7.0
# Most projects reject a work item without these two.
ADO_AREA_PATH=
ADO_ITERATION_PATH=
# Optional: any other fields, as JSON. Keys may omit the /fields/ prefix.
ADO_EXTRA_FIELDS={"System.AssignedTo":"qa@your-company.com"}

# ---- TFS (on-prem) ----
# Same work-item API as Azure DevOps, older api-version.
TFS_COLLECTION_URL=https://tfs.your-company.local/tfs/DefaultCollection
TFS_PROJECT=
TFS_PAT=
TFS_WORK_ITEM_TYPE=Test Case
TFS_API_VERSION=5.1
TFS_AREA_PATH=
TFS_ITERATION_PATH=
TFS_EXTRA_FIELDS=

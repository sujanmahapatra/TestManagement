{
  "name": "tcg-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Test Case Generator - Jira integration service",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jszip": "^3.10.2",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "undici": "^7.30.0",
    "unpdf": "^1.8.1",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=22.9"
  }
}
